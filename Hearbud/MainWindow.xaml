<Window x:Class="Hearbud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hearbud" Width="960"
        MinHeight="440" MinWidth="900"
        ResizeMode="CanMinimize"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource ControlForeground}"
        UseLayoutRounding="True">
    <DockPanel LastChildFill="True" Margin="16">
        <!-- Main content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="30"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Devices -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="Audio Devices" Margin="0,0,8,4">
                <StackPanel Margin="6">
                    <Border x:Name="UsbWarningBanner" Visibility="Collapsed"
                            Margin="0,0,0,8" Padding="8,6"
                            Background="#33EA7D24"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="UsbWarningText" TextWrapping="Wrap" FontSize="11"
                                   Foreground="#FFFFD28A"
                                   AutomationProperties.Name="USB layout warning"/>
                    </Border>
                    <CheckBox x:Name="IncludeMicCheck" Content="Microphone (Input)" FontWeight="SemiBold"
                              IsChecked="True"
                              Checked="OnIncludeSourceChanged" Unchecked="OnIncludeSourceChanged"
                              ToolTip="Uncheck to mute the microphone — the input list is disabled and nothing is recorded from it"
                              AutomationProperties.Name="Include microphone"/>
                    <ComboBox x:Name="MicCombo"
                              Margin="0,4,0,0"
                              AutomationProperties.Name="Microphone Selection"
                              AutomationProperties.HelpText="Select the microphone to record from"/>
                    <CheckBox x:Name="RecordSysCheck" Content="Audio Output (to capture)" FontWeight="SemiBold"
                              IsChecked="True" Margin="0,12,0,0"
                              Checked="OnIncludeSourceChanged" Unchecked="OnIncludeSourceChanged"
                              ToolTip="Uncheck to mute system audio — the output list is disabled and nothing is captured from it"
                              AutomationProperties.Name="Include system audio"/>
                    <ComboBox x:Name="SpeakerCombo" Margin="0,4,0,0"
                              AutomationProperties.Name="Output device selection"/>
                </StackPanel>
            </GroupBox>

            <!-- Output (basic only; format/limits/hotkeys live in Settings…) -->
            <GroupBox Grid.Row="0" Grid.Column="1" Header="Output" Margin="8,0,0,4">
                <StackPanel Margin="6">
                    <TextBlock Text="Save Location" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,0">
                        <Button Content="Browse…" Margin="8,0,0,0" Click="OnBrowseFolder" DockPanel.Dock="Right"/>
                        <TextBox x:Name="OutputFolderText" IsReadOnly="True" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Base File Name (no extension)" Margin="0,12,0,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="BaseNameText" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Gain + live levels, side by side in one group -->
            <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Audio" Margin="0,4,0,4">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gains -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mic Gain" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Slider Grid.Column="1" x:Name="MicGain" Minimum="0.0" Maximum="3.0" Value="1.0"
                                    ValueChanged="OnGainChanged"/>
                            <TextBlock Grid.Column="2" x:Name="MicGainLabel" TextAlignment="Right" TextWrapping="NoWrap"
                                       FontFamily="Consolas" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Height="30" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Output Gain" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Slider Grid.Column="1" x:Name="LoopGain" Minimum="0.0" Maximum="3.0" Value="1.0"
                                    ValueChanged="OnGainChanged"/>
                            <TextBlock Grid.Column="2" x:Name="LoopGainLabel" TextAlignment="Right" TextWrapping="NoWrap"
                                       FontFamily="Consolas" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="0,2"
                            Background="{StaticResource ControlBorder}"/>

                    <!-- Live levels -->
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mic" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ProgressBar Grid.Column="1" x:Name="MicBar" Minimum="0" Maximum="100" Margin="10,0"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Microphone Level"
                                         AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Grid.Column="2" x:Name="MicDb" TextAlignment="Right" TextWrapping="NoWrap" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" x:Name="MicClip" Text="CLIP" Foreground="{StaticResource ControlDisabled}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold"/>
                        </Grid>
                        <Grid Height="30" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="System" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ProgressBar Grid.Column="1" x:Name="SysBar" Minimum="0" Maximum="100" Margin="10,0"
                                         VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="SysDb" TextAlignment="Right" TextWrapping="NoWrap" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" x:Name="SysClip" Text="CLIP" Foreground="{StaticResource ControlDisabled}" VerticalAlignment="center" Margin="8,0,0,0" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <Button x:Name="RefreshBtn" Content="Refresh Devices" Click="OnRefreshDevices"/>
                <Button x:Name="SettingsBtn" Content="Settings…" Click="OnOpenSettings" Margin="8,0,0,0"
                        AutomationProperties.Name="Open settings"
                        ToolTip="Output format, auto-stop limits, countdown and shortcuts"/>
            </StackPanel>

            <!-- Status bar + transport footer -->
            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0"/>
            <DockPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0" Height="30">
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Opacity="0.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Height="30">
                    <Button x:Name="StartBtn" Content="Start Recording (Ctrl+R)" Click="OnStart"
                            Style="{StaticResource AccentButton}"
                            AutomationProperties.Name="Start Recording"
                            AutomationProperties.AcceleratorKey="Ctrl+R"/>
                    <Button x:Name="PauseBtn" Content="Pause (Ctrl+P)" Click="OnPauseResume" IsEnabled="False" Margin="8,0,0,0"
                            AutomationProperties.Name="Pause Recording"
                            AutomationProperties.AcceleratorKey="Ctrl+P"/>
                    <Button x:Name="StopBtn" Content="Stop (Ctrl+S)" Click="OnStop" IsEnabled="False" Margin="8,0,0,0"
                            Style="{StaticResource AccentButton}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="30">
                    <TextBlock x:Name="ElapsedText" Text="00:00" Visibility="Collapsed" Margin="0,0,12,0"
                               FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"
                               AutomationProperties.Name="Recording elapsed time"/>
                    <TextBlock x:Name="StatusText" Text="Ready to record" Opacity="0.8" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    <Button x:Name="CancelCountdownBtn" Content="Cancel" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="OnCancelCountdown"
                            AutomationProperties.Name="Cancel countdown"/>
                    <ProgressBar x:Name="EncodingProgressBar" Width="90" Margin="12,0,0,0" Visibility="Collapsed" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="EncodingProgressText" Text="0%" Margin="5,0,0,0" Visibility="Collapsed" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
