<Window x:Class="Hearbud.MiniBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearbud Mini" Height="150" Width="280"
        MinHeight="150" MinWidth="280"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource ControlForeground}"
        UseLayoutRounding="True">
    <StackPanel Margin="10">
        <TextBlock x:Name="TimeText" Text="00:00" FontSize="22" FontFamily="Consolas"
                   HorizontalAlignment="Center"/>
        <ProgressBar x:Name="MicBar" Minimum="0" Maximum="100" Height="10" Margin="0,8,0,0"
                     AutomationProperties.Name="Microphone Level"/>
        <ProgressBar x:Name="SysBar" Minimum="0" Maximum="100" Height="10" Margin="0,4,0,0"
                     AutomationProperties.Name="System Level"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="PauseBtn" Content="Pause" Click="OnPauseClick" MinWidth="80"
                    AutomationProperties.Name="Pause Recording"/>
            <Button x:Name="StopBtn" Content="Stop" Click="OnStopClick" MinWidth="80" Margin="8,0,0,0"
                    AutomationProperties.Name="Stop Recording"/>
        </StackPanel>
    </StackPanel>
</Window>
